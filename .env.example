# AWS S3 configuration
AWS_ACCESS_KEY_ID = "Your_AWS_Access_Key_ID"
AWS_SECRET_ACCESS_KEY = "Your_AWS_Secret_Access_Key"
AWS_REGION = "us-east-1"
S3_BUCKET = "Your_S3_Bucket_Name"

# Bedrock Model configuration
BEDROCK_EMBED_MODEL = "amazon.titan-embed-text-v2:0"
BEDROCK_CHAT_MODEL = "amazon.nova-2-lite-v1:0"
EMBED_DIM = 1024

# Pinecone Vector Database configuration
PINECONE_API_KEY = "Your_Pinecone_API_Key"
PINECONE_INDEX_HOST = "atlas-enterprise-ai-index"  #kind of database name on Pinecone. For table you call it namespace. 
PINECONE_CLOUD = "aws"
PINECONE_REGION = "us-east-1"
PINECONE_READY_TIMEOUT = 180

# Postgres Database configuration
DATABASE_URL = "postgresql://atlas_user:Your_Postgres_Password@Your_Postgres_Host/atxsddxss?sslmode=require"
# We are using render as it provides a server, but on a server, it is not possible to visualise the tables, So we need a third-party client. 
# pgadmin is a third party client to see the postgres database. You can use it to see the tables and data in the database. 

# RIUS Observability configuration
RIUS_API_KEY = "Your_RIUS_API_Key"
RIUS_SERVICE_NAME = "atlas-ai-enterprise"
RIUS_DISABLED = "False"
RIUS_CAPTURE_CONTENT = "False"